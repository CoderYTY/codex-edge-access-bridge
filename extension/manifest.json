{
  "manifest_version": 3,
  "name": "Codex Edge Access Bridge",
  "version": "0.1.0",
  "description": "Allow a local Codex bridge to inspect and operate Microsoft Edge tabs.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Codex Edge Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
